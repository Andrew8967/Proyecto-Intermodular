# =====================================================================
#  Configuración del HOST Proxmox VE — Proyecto Intermodular (2º SMR)
#  La leen los scripts de la carpeta proxmox/ (se ejecutan en el
#  propio Proxmox, como root). Cambia los valores antes de empezar.
# =====================================================================

# --- Red ---------------------------------------------------------------
GATEWAY="192.168.1.1"
LAN_SUBNET="192.168.1.0/24"
DNS="192.168.1.1"
BRIDGE="vmbr0"                   # puente de red que crea Proxmox al instalarse
# IP del propio Proxmox (se elige en el instalador): https://192.168.1.10:8006

# --- Contenedor de Minecraft (CT 101) — Andrés -------------------------
CTID=101
CT_HOSTNAME="mc-server"
CT_IP="192.168.1.100"            # IP fija del contenedor (la de Minecraft y el panel)
CT_CORES=4                       # núcleos que puede usar como máximo
CT_MEMORY=8192                   # MB de RAM (Minecraft usa 4 GB; el resto, para el sistema)
CT_SWAP=1024                     # MB de swap
CT_DISK_GB=40                    # tamaño del disco del contenedor
CT_STORAGE="local-lvm"           # dónde se guarda el disco del CT (el SSD)
TEMPLATE_STORAGE="local"         # dónde se guardan las plantillas
ADMIN_USER="andres"              # usuario con sudo que se crea dentro del CT
SSH_PUBKEY_FILE=""               # opcional: ruta a tu clave pública (ej. /root/andres.pub)
REPO_URL="https://github.com/Andrew8967/Proyecto-Intermodular.git"

# --- Disco externo (1-2 TB) --------------------------------------------
# Se monta en el HOST (ver docs/04-instalacion.md) y se reparte así:
EXTERNAL_MOUNT="/mnt/externo"
CT_BACKUP_HOST_DIR="/mnt/externo/ct101"      # se ve dentro del CT como /mnt/externo
PROXMOX_BACKUP_DIR="/mnt/externo/proxmox"    # copias completas (vzdump) de los CT/VM
# Alberto: /mnt/externo/alberto  (lo gestiona él)

# --- Copias completas con vzdump ---------------------------------------
VZDUMP_SCHEDULE="sun 03:00"      # una vez por semana (domingo 03:00)
VZDUMP_KEEP="keep-last=4"        # guardar las 4 últimas
