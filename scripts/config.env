# =====================================================================
#  Configuración común del servidor — Proyecto Intermodular (2º SMR)
#  Todos los scripts de esta carpeta leen este archivo.
#  Se ejecutan DENTRO del contenedor LXC de Minecraft (CT 101, Debian 13)
#  que crea proxmox/02-crear-ct-minecraft.sh (ese script ya rellena
#  ADMIN_USER, SERVER_IP, LAN_SUBNET y GATEWAY). También funcionan en una
#  VM o un PC con Debian 13 normal, para hacer pruebas.
# =====================================================================

# --- Usuario administrador -------------------------------------------
# El usuario normal que creaste al instalar Debian (NO root).
# Si lo dejas vacío, se usa el usuario que ejecuta "sudo".
ADMIN_USER=""

# Otros usuarios que pueden entrar por SSH (por ejemplo "alberto"), separados por espacios
EXTRA_SSH_USERS=""

# --- Red ---------------------------------------------------------------
# IP fija del servidor (o reserva DHCP en el router) y red local.
SERVER_IP="192.168.1.100"
LAN_SUBNET="192.168.1.0/24"
GATEWAY="192.168.1.1"
TIMEZONE="Europe/Madrid"
# Pon "si" SOLO en la máquina virtual con red NAT (VirtualBox/QEMU): abre el firewall a 10.0.2.0/24
SIMULACION_NAT="no"

# --- Minecraft (PaperMC) ----------------------------------------------
MC_USER="minecraft"            # usuario de sistema sin login que ejecuta el servidor
MC_DIR="/opt/minecraft"
PAPER_VERSION="1.21.4"         # versión de Minecraft; compruébala en https://papermc.io/downloads
JAVA_PACKAGE="openjdk-21-jre-headless"   # versiones nuevas de Minecraft pueden pedir Java 25
MC_RAM="4G"                    # memoria para Java (con 16 GB de RAM, 4G sobra para 5-10 jugadores)
MC_MAX_PLAYERS=10
MC_MOTD="Servidor Intermodular - 2 SMR"
MC_VIEW_DISTANCE=8
MC_SIMULATION_DISTANCE=6
MC_WHITELIST="true"            # solo entran los jugadores añadidos con "whitelist add <nombre>"
RCON_PORT=25575                # solo se usa desde el propio servidor (NO se abre en el firewall)

# --- Panel de monitorización ------------------------------------------
WEB_ROOT="/var/www/html"
PANEL_INTERVAL=10              # segundos entre cada lectura de datos
# Servicios que el panel vigila (separados por espacios)
PANEL_SERVICES="ssh apache2 minecraft fail2ban panel-status minecraft-backup.timer"
# Discos que muestra el panel: "Nombre=ruta" separados por comas
PANEL_DISKS="Disco del CT (SSD)=/,Disco externo=/mnt/externo"

# --- Copias de seguridad ----------------------------------------------
# Punto de montaje del disco externo de 1-2 TB (ver docs/04-instalacion.md)
EXTERNAL_MOUNT="/mnt/externo"
BACKUP_DIR="/mnt/externo/backups/minecraft"
BACKUP_KEEP=7                  # cuántas copias guardar (una por noche = una semana)
BACKUP_TIME="04:00"            # hora de la copia diaria
